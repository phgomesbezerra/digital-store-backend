# Copie este arquivo para .env e preencha com os seus dados locais.
# O arquivo .env NAO vai para o GitHub (esta no .gitignore).

# Porta onde a API vai rodar
PORT=3000

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=senha_do_mysql
# Nome do banco padronizado do projeto
DB_NAME=digitalcollegebr

# Chave secreta do JWT (sera usada na etapa de autenticacao)
JWT_SECRET=troque_por_uma_chave_secreta
